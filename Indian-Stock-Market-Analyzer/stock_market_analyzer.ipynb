      "source": [
        "**Indian-Stock-Market-Analyzer**"
      ],
      "metadata": {
        "id": "C8OTgP_Tzgst"
      }
    },
    {
      "cell_type": "code",
      "execution_count": 95,
      "metadata": {
        "id": "03g6zAgvfptL"
      },
      "outputs": [],
      "source": [
        "import yfinance as yf"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "def get_stock_prices(symbol):\n",
        "  stock=yf.Ticker(symbol)\n",
        "  data=stock.history(period=\"2d\")\n",
        "  if len(data) < 2:\n",
        "        print(f\" Could not fetch enough data for {symbol}\")\n",
        "        return None, None, None\n",
        "\n",
        "  today=data[\"Close\"].iloc[-1]\n",
        "  yesterday=data[\"Close\"].iloc[-2]\n",
        "  daily_return=((today-yesterday)/yesterday)*100\n",
        "  return today,yesterday,daily_return\n",
        "\n"
      ],
      "metadata": {
        "id": "LS6gewVuK6lG"
      },
      "execution_count": 99,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "stocks = [\n",
        "    \"RELIANCE.NS\",\n",
        "    \"TCS.NS\",\n",
        "    \"INFY.NS\",\n",
        "    \"HDFCBANK.NS\",\n",
        "    \"ICICIBANK.NS\",\n",
        "    \"SBIN.NS\",\n",
        "    \"LT.NS\",\n",
        "    \"HINDUNILVR.NS\",\n",
        "    \"ITC.NS\",\n",
        "    \"BHARTIARTL.NS\"\n",
        "]\n",
        "company_info = {\n",
        "    \"RELIANCE.NS\": \"Energy\",\n",
        "    \"TCS.NS\": \"Information Technology\",\n",
        "    \"INFY.NS\": \"Information Technology\",\n",
        "    \"HDFCBANK.NS\": \"Banking\",\n",
        "    \"ICICIBANK.NS\": \"Banking\",\n",
        "    \"SBIN.NS\": \"Banking\",\n",
        "    \"LT.NS\": \"Infrastructure\",\n",
        "    \"HINDUNILVR.NS\": \"FMCG\",\n",
        "    \"ITC.NS\": \"FMCG\",\n",
        "    \"BHARTIARTL.NS\": \"Telecommunications\"}\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"Indian Stock Market Report\")\n",
        "print(\"=\" * 60)\n",
        "market_data=[]\n",
        "for company in stocks:\n",
        "  today,yesterday,daily_return=get_stock_prices(company)\n",
        "  if today is None:\n",
        "    continue\n",
        "  company_data={\"company\":company,\n",
        "                \"Sector\": company_info[company],\n",
        "                \"Todays price\":round(today,2),\n",
        "                \"yesterdays price\":round(yesterday,2),\n",
        "                \"Daily returns\":round(daily_return,2)\n",
        "                }\n",
        "  market_data.append(company_data)\n",
        "\n",
        " #we can check teh data inteh market dat column\n",
        "import pandas as pd\n",
        "\n",
        "df = pd.DataFrame(market_data)\n",
        "print(df)\n",
        "best_stock = df.loc[df[\"Daily returns\"].idxmax()]\n",
        "worst_stock = df.loc[df[\"Daily returns\"].idxmin()]\n",
        "average_return = df[\"Daily returns\"].mean()\n",
        "\n",
        "#printing teh final report\n",
        "print(\"=\" * 60)\n",
        "print(\"Indian Stock Market Report\")\n",
        "print(\"=\" * 60)\n",
        "
        "\n",
        "#rather than using if and for statemnt we are usng the idmin and max one\n",
        "\n",
        "for stock in market_data:\n",
        "  print(f\"Company           : {stock[\"company\"]}\")\n",
        "  print(f\"Today's Price     :  ₹{stock['Todays price']:.2f}\")\n",
        "  print(f\"Yesterday's Price :  ₹{stock['yesterdays price']:.2f}\")\n",
        "  print(f\"Daily Return      : {stock['Daily returns']:.2f}%\")\n",
        "\n",
        "print(\"=\"* 50)\n",
        "print(\"\\n Best Performing Stock\")\n",
        "print(best_stock[\"company\"])\n",
        "print(f\"Return: {best_stock['Daily returns']:.2f}%\")\n",
        "print(\"\\n Worst Performing Stock\")\n",
        "print(worst_stock[\"company\"])\n",
        "print(f\"Return: {worst_stock['Daily returns']:.2f}%\")\n",
        "print(f\"\\nAverage Market Return : {average_return:.2f}%\")\n",
        "colors = []\n",
        "\n",
        "for value in df[\"Daily returns\"]:\n",
        "    if value >= 0:\n",
        "        colors.append(\"green\")\n",
        "    else:\n",
        "        colors.append(\"red\")\n",
        "for value in df[\"Todays price\"]:\n",
        "    if value >= 0:\n",
        "        colors.append(\"green\")\n",
        "    else:\n",
        "        colors.append(\"red\")\n",
        "\n",
        "import matplotlib.pyplot as plt\n",
        "plt.figure(figsize=(12,6))\n",
        "\n",
        "plt.bar(df[\"company\"],df[\"Todays price\"],color=colors)\n",
        "plt.tight_layout()\n",
        "plt.xticks(rotation=30, ha=\"right\")\n",
        "plt.title(\"Today's Stock Prices of Selected Indian Companies\")\n",
        "\n",
        "plt.xlabel(\"Company\")\n",
        "\n",
        "plt.ylabel(\"Price (₹)\")\n",
        "plt.show()\n",
        "print(\"\\n\")\n",
        "plt.figure(figsize=(12,6))\n",
        "plt.bar(df[\"company\"],df[\"Daily returns\"],color=colors)\n",
        "plt.tight_layout()\n",
        "plt.xticks(rotation=30, ha=\"right\")\n",
        "plt.title(\"Daily Stock Returns of Selected Indian Companies\")\n",
        "\n",
        "plt.xlabel(\"Company\")\n",
        "\n",
        "plt.ylabel(\"Returns (%)\")\n",
        "plt.show()\n",
        "df.to_csv(\"stock_market_report.csv\", index=False)\n",
        "\n",
        "print(\"\\n✅ Report saved as stock_market_report.csv\")\n"
      ],
